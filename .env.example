# Postgres — только для локального запуска, на сервере будет другой пароль
POSTGRES_USER=msc
POSTGRES_PASSWORD=msc_local_only
POSTGRES_DB=msc
DATABASE_URL=postgres://msc:msc_local_only@localhost:5432/msc

# Бот — токен выдают организаторы, в git его нет
BOT_TOKEN=
BOT_MODE=polling

# Мини-приложение (Vite читает только VITE_*)
VITE_API_URL=http://localhost:3001
VITE_API_MOCK=1
VITE_DEMO_MODE=1
VITE_BOT_NAME=

# API
API_PORT=3001
PHOTOS_DIR=./data/photos
CORS_ORIGIN=http://localhost:5173

# Домен для Caddy: пусто — локально на :80 без TLS, на сервере — example.ru
PUBLIC_DOMAIN=

# Идентификаторы пользователей MAX в БД (packages/db: users.user_hash / users.user_id_enc)
# Сгенерировать: openssl rand -hex 32
USER_HASH_SECRET=
# Сгенерировать: openssl rand -base64 32  (ровно 32 байта)
USER_ID_ENC_KEY=
# Подписанная initData для мини-приложения в браузере, чтобы ходить в настоящий API без MAX:
#   pnpm --filter @msc/api sign-init-data   → последнюю строку сюда
VITE_DEV_INIT_DATA=
