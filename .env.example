# Postgres — только для локального запуска, на сервере будет другой пароль
POSTGRES_USER=msc
POSTGRES_PASSWORD=msc_local_only
POSTGRES_DB=msc
DATABASE_URL=postgres://msc:msc_local_only@localhost:5432/msc

# Бот — токен выдают организаторы, в git его нет
BOT_TOKEN=
# polling — локально; webhook — на сервере (нужны PUBLIC_DOMAIN и WEBHOOK_SECRET)
BOT_MODE=polling
# Секрет, который MAX прикладывает к каждому апдейту. Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=

# Мини-приложение (Vite читает только VITE_*)
VITE_API_URL=http://localhost:3001
VITE_API_MOCK=1
VITE_DEMO_MODE=1
VITE_BOT_NAME=

# API
API_PORT=3001
PHOTOS_DIR=./data/photos
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Ссылка «Поделиться заявкой» в мини-приложении: https://max.ru/<ник бота>, без / на конце.
# Пусто — кнопки «Поделиться» и копирования не работают.
APP_LINK=https://max.ru/t146_hakaton_max_bot

# Демо-режим: перемотка времени и роль диспетчера одним аккаунтом.
# На защите нужен: без него не показать ни просрочку, ни рост суммы, ни кабинет УК.
DEMO_MODE=1
# Ссылка на мини-приложение для кнопки «Поделиться в чат дома».
# Без неё shareUrl приходит пустым и копировать нечего.
APP_LINK=https://max.ru/<ник бота>

# Домен для Caddy: пусто — локально на :80 без TLS, на сервере — example.ru
PUBLIC_DOMAIN=

# Идентификаторы пользователей MAX в БД (packages/db: users.user_hash / users.user_id_enc)
# Сгенерировать: openssl rand -hex 32
USER_HASH_SECRET=
# Сгенерировать: openssl rand -base64 32  (ровно 32 байта)
USER_ID_ENC_KEY=
# Подписанная initData для мини-приложения в браузере, чтобы ходить в настоящий API без MAX:
#   pnpm --filter @msc/api sign-init-data   → последнюю строку сюда
VITE_DEV_INIT_DATA=
