# Шаблон настроек. Скопировать: cp .env.example .env — и заполнить пустые значения.
# .env в git не попадает. Что менять на сервере — docs/operations.md, «Развернуть на новом сервере».

# ── База ────────────────────────────────────────────────────────────────
# Пароль из примера — только для локального запуска, на сервере свой: openssl rand -hex 24
POSTGRES_USER=msc
POSTGRES_PASSWORD=msc_local_only
POSTGRES_DB=msc
# Для запуска без Docker; в Docker адрес базы задаётся в compose.yaml
DATABASE_URL=postgres://msc:msc_local_only@localhost:5432/msc
# Тесты API на настоящей базе (необязательно): postgres://msc:msc_local_only@localhost:5432/msc_test
TEST_DATABASE_URL=

# ── Бот ─────────────────────────────────────────────────────────────────
# Токен выдают организаторы, в git его нет
BOT_TOKEN=
# polling — локально; webhook — на сервере (нужны PUBLIC_DOMAIN и WEBHOOK_SECRET).
# На один токен — один запущенный бот: polling снимает webhook у бота на сервере.
BOT_MODE=polling
# Секрет, который MAX прикладывает к каждому событию webhook: openssl rand -hex 32
WEBHOOK_SECRET=
# 1 — запустить polling, даже если токен подписан на webhook (бот на сервере). Только если
# бот на сервере остановлен, иначе он перестанет отвечать. Без флага локальный бот откажется стартовать.
FORCE_POLLING=
# Ссылка на бота без / на конце: из неё собираются «Поделиться», «У меня тоже» и приглашения исполнителей
APP_LINK=https://max.ru/t146_hakaton_max_bot

# ── Идентификаторы пользователей MAX ────────────────────────────────────
# Генерируются ОДИН РАЗ и больше не меняются: иначе пользователи «потеряются», а уведомления
# перестанут доходить. Копию хранить вне сервера.
# openssl rand -hex 32
USER_HASH_SECRET=
# openssl rand -base64 32  (ровно 32 байта)
USER_ID_ENC_KEY=
# Сколько секунд действуют данные запуска мини-приложения (initData)
INIT_DATA_MAX_AGE_SEC=3600

# ── API ─────────────────────────────────────────────────────────────────
API_PORT=3001
PHOTOS_DIR=./data/photos
# Откуда разрешены запросы к API, через запятую. На сервере: https://<домен>
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Сколько запросов в минуту разрешено одному пользователю
RATE_LIMIT_MAX=120
# Окно, в котором повторная заявка той же категории считается случайным дублем, минут
DUPLICATE_WINDOW_MIN=10
# Сколько живёт временная подписанная ссылка на PDF-документ, минут
DOC_LINK_TTL_MIN=30

# ── Демо-режим ──────────────────────────────────────────────────────────
# Перемотка времени и роль диспетчера одним аккаунтом. На защите — 1 (без него не показать
# просрочку, рост суммы и кабинет УК), в пилоте — 0.
DEMO_MODE=1

# ── Caddy ───────────────────────────────────────────────────────────────
# Пусто — локально на :80 без TLS; на сервере — домен, HTTPS настроится сам
PUBLIC_DOMAIN=

# ── Мини-приложение (Vite читает только VITE_*, на этапе сборки) ────────
VITE_API_URL=http://localhost:3001
VITE_API_MOCK=1
VITE_DEMO_MODE=1
VITE_BOT_NAME=
# Подписанная initData, чтобы в браузере ходить в настоящий API без MAX:
#   pnpm --filter @msc/api sign-init-data   → последнюю строку сюда
VITE_DEV_INIT_DATA=
