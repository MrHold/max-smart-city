{
  "name": "@msc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "sign-init-data": "tsx --env-file-if-exists=../../.env src/dev/sign-init-data.ts",
    "openapi": "tsx src/dev/openapi.ts",
    "check-openapi": "tsx --env-file-if-exists=../../.env src/dev/check-openapi.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@msc/db": "workspace:*",
    "@msc/documents": "workspace:*",
    "@msc/domain": "workspace:*",
    "fastify": "5.12.5",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "vitest": "5.0.1"
  }
}
